# DeepSeek API Key (从 platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型路径（本地缓存）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 设为 true 仅用本地缓存（离线模式）
LOCAL_FILES_ONLY=false
# HuggingFace 镜像（国内用户可设为 https://hf-mirror.com）
HF_ENDPOINT=

# 服务配置
HOST=0.0.0.0
PORT=8000

# FAISS 索引配置（Flat / HNSW / IVF / HNSW_PQ）
FAISS_INDEX_TYPE=Flat
HNSW_M=32
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=64
IVF_NLIST=256
IVF_NPROBE=10

# 文档切分配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 微信机器人配置 (v2.0)
WECHAT_APPID=
WECHAT_APPSECRET=

# 定时任务配置 (v2.0)
DAILY_LOG_ENABLED=true
DAILY_LOG_TIME=22:00
SCHEDULE_REVIEW_TIME=09:30
